# ==== Supabase ====
# Lấy tại: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# Service role key — CHỈ dùng phía server (API route tạo nhân viên).
# TUYỆT ĐỐI không để lộ ra client / commit lên git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# ==== App ====
# URL công khai của app (dùng để sinh link QR cho khách). Không có dấu "/" cuối.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
